<!DOCTYPE html>
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jersey+10&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="game.css">
    </head>
    <body>
        <title>Game</title>
        <h1 class = "game-title"> Welcome to the Memory Game!</h1>
        <main>
            <div class = "info-container">
                <h1 class = "score-container"> Score: # pts</h1>
            </div>
            <div class = "button-container">
                <button class = "action-button" id = "red" style = "background-color: red;"> RED </button>
                <button class = "action-button" id = "orange" style = "background-color: orange;"> ORANGE </button>
                <button class = "action-button" id = "yellow" style = "background-color: yellow;"> YELLOW </button>
                <button class = "action-button" id = "green"style = "background-color: green;"> GREEN </button>
                <button class = "action-button" id = "blue" style = "background-color: blue;"> BLUE </button>
                <button class = "action-button" id = "purple" style = "background-color: purple;"> PURPLE </button>
            </div>
            <div class="controls">
    <button id="start-btn">Start Game</button>
    <button id="save-btn">Save Score</button>
</div>

            <div class = "highscore-container"> Highscores:
                <% Object.keys(highscores).forEach(function (highscore) { %>
                    <%- include("partials/highscore", {
                        highscore: highscores[highscore]
                    }) %>
                <% }) %>
            </div>
            <div id="game-over-modal">

                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <h2>Game Over!</h2>
                    <p>Your final score is: ### pts</p>
                    <p>Enter your name to save your score:</p>
                    <input type="text" id="player-name" name="player-name">
                </div>

        </main>
        
        <!-- Moved <script> tags here so they'll run after all the HTML content has loaded. -->
        <script src="highscoreTemplate.js"></script>
        <script src="game.js"></script>
    </body>
</html>