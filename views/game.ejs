<!DOCTYPE html>
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Jersey+10&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="game.css">
        <script src="game.js"></script>
    </head>
    <body>
        <title>Game</title>
        <h1 class = "game-title"> Welcome to our Game!</h1>
        <main>
            <div class = "info-container">
                <h1 class = "lives-container"> Lives: #</h1>
                <h1 class = "score-container"> Score: # pts</h1>
            </div>
            <div class = "button-container">
                <button class = "action-button"> Action 1 </button>
                <button class = "action-button"> Action 2 </button>
                <button class = "action-button"> Action 3 </button>
                <button class = "action-button"> Action 4 </button>
                <button class = "action-button"> Action 5 </button>
                <button class = "action-button"> Action 6 </button>
            </div>
            <div class = "highscore-container"> Highscores:
                <% Object.keys(highscores).forEach(function (highscore) { %>
                    <%- include("partials/highscore", {
                        highscore: highscores[highscore]
                    }) %>
                <% }) %>
            </div>
            <modal id="game-over-modal">
                <div class="modal-content">
                    <span class="close-button">&times;</span>
                    <h2>Game Over!</h2>
                    <p>Your final score is: ### pts</p>
                    <p>Enter your name to save your score:</p>
                    <input type="text" id="player-name" name="player-name" maxlength="">
                </div>
        </main>
    </body>
</html>